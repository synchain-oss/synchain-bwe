# Allow-list: only the files this repository needs are tracked. Everything else stays out, above all audio, model
# files, ceiling files and reports (those describe a real voice).
/*
!/.gitignore
!/.gitattributes
!/.gitleaks-version
!/.gitleaks-sha256
!/.gitleaks.toml
!/CONTRIBUTING.md
!/LICENSE
!/LICENSES/
!/README.md
!/README.zh-CN.md
!/REUSE.toml
!/SECURITY.md
!/pyproject.toml
!/src/
!/tests/
!/.github/
/LICENSES/**/*
!/LICENSES/**/
!/LICENSES/**/*.txt
/src/**/*
!/src/**/
!/src/**/*.py
/tests/**/*
!/tests/**/
!/tests/**/*.py
/.github/**/*
!/.github/**/
!/.github/workflows/*.yml
!/.github/actions/*/action.yml
!/.github/dependabot.yml
!/.github/CODEOWNERS
!/.github/pull_request_template.md
__pycache__/
